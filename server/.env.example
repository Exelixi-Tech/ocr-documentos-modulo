# ─── Modulo OCR · Backend ────────────────────────────────────────────
# Copia este archivo a .env y completa los valores.

# Puerto en el que escucha el servidor (default 4001)
PORT=4001

# Origenes permitidos por CORS (* para abrir totalmente, recomendado en dev)
CORS_ORIGINS=*

# Tamano maximo permitido por archivo subido en MB
UPLOAD_MAX_SIZE_MB=25

# Expediente: {nombreEmpresa}/{cedula}/{recibo-aa-mes-poliza}/
# Por defecto: server/uploads. En srv001 puede ser una ruta compartida.
# EXPEDIENTES_ROOT=/home/jsoto/exelixi/expedientes
# Nombre si el JWT no trae empresa (iframe / bypass)
EXPEDIENTE_EMPRESA_FALLBACK=La Mundial de Seguros
# Clave opcional para commit desde emision-api (si no, solo localhost)
# EXPEDIENTE_INTERNAL_KEY=

# Limite del body JSON
JSON_BODY_LIMIT=1mb

# Flujo genérico Exélixi (catálogo product-builder) — acceso OCR sin nexus_token
BUILDER_CATALOG_MODE=true

# Filtro opcional del selector OCR. SIN esta variable (o con '*') se listan
# TODOS los productos emitibles del product-builder — los ramos/productos
# nuevos aparecen automáticamente. Para restringir, lista nombres comerciales
# separados por coma:
# CATALOG_PRODUCT_ALLOWLIST=Automovil Exelixi TEST,Gastos Funerarios Exelixi TEST

# ─── Catálogo Exélixi (product-builder) ───────────────────────────────
# El front OCR lista ramos/planes creados en product-builder antes del paso OCR.
PRODUCT_BUILDER_API_URL=http://127.0.0.1:3001
PRODUCT_BUILDER_API_EMAIL=nest-api@exelixitech.com
PRODUCT_BUILDER_API_PASSWORD=

# ─── Multi-tenant (Nexus) ─────────────────────────────────────────────
# Si true, todas las rutas /api requieren un nexus_token valido.
NEXUS_AUTH_ENABLED=true
# Mismo secret configurado en nexus-api (TENANT_TOKEN_SECRET).
# IMPORTANTE: debe coincidir exactamente con el de nexus-api.
TENANT_TOKEN_SECRET=
# Id del submodulo OCR en la BD de nexus (tabla submodulo). Necesario
# para impedir que un token emitido para otro submodulo sea aceptado.
# 17=OCR RCV · 21=OCR Funerario · 29=OCR Catálogo Exélixi
NEXUS_EXPECTED_SUBMODULO_IDS=17,21,29

# ─── Proveedor OCR ────────────────────────────────────────────────────
# mock | gemini
OCR_PROVIDER=gemini

# Google Gemini — obtener key en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modelo principal. Si falla, el provider hace fallback automatico:
# gemini-2.5-pro -> gemini-2.5-flash -> gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-pro

# Reintentos por modelo en errores transitorios (429, 5xx, timeout)
GEMINI_MAX_RETRIES=2

# Flujo RCV por tarjeta de farmacia (validate-card / validate_bill)
LAMUNDIAL_CARDS_URL=https://qaapisys2000.lamundialdeseguros.com
# Opcional. Si vacío, se reusa LAMUNDIAL_APIKEY o se llama sin apikey.
# LAMUNDIAL_CARDS_APIKEY=
